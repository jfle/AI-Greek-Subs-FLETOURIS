# AIO-Streams&Subtitles-Greek — example environment. Copy to .env (Docker) or set in the systemd unit.
# All variables are optional.

# Listen port and address
PORT=7000
HOST=0.0.0.0

# Public HTTPS base URL that Stremio uses (set it behind a reverse proxy / tunnel)
# PUBLIC_URL=https://subs.example.com

# Second address that works outside the home network (public IP + forwarded port, or your domain/tunnel).
# Requires CONFIG_PASSWORD for configuration requests that arrive through it.
# EXTERNAL_URL=https://194-0-2-10.local-ip.sh:8443

# Password for the configure page (recommended when the page is reachable from the internet)
# CONFIG_PASSWORD=change-me

# Where the encryption key, sign-ins and cache are stored
DATA_DIR=./data

# Encryption secret for the settings inside addon links. Default: random key saved in DATA_DIR/secret.key.
# Changing it invalidates existing install links.
# SECRET=a-long-random-string

# Days to keep finished translations
CACHE_DAYS=30

# Longest a subtitle request waits before sending partial results (ms, max 9000)
SUBTITLE_WAIT_MS=8500
